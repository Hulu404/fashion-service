# Copy to .env.local and fill in. Do NOT put real secrets in this file —
# it is committed to the repo. .env.local is gitignored.

# Supabase — a single public pair is all the app needs.
# Used by the browser client, by the API routes (with the user's access token),
# and as the fallback for server-side reads (trends).
NEXT_PUBLIC_SUPABASE_URL=https://lzypkomkfywhxbbvqppk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_SGxFoSfHQL3y7pIxvXSr7Q_j2FAJFwS


# Optional: dedicated server-side credentials. Only set these if you need to
# read past RLS on the server; otherwise the public pair above is used.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — required for photo analysis (/api/analyze) and looks (/api/looks).
ANTHROPIC_API_KEY=
